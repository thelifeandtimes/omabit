{
  "schemaVersion": 1,
  "id": "io.omabit.tend",
  "name": "Tend",
  "version": "0.1.0",
  "author": "Omabit",
  "description": "Urbit-backed multiplayer reminders for Omarchy",
  "kinds": [
    "panel",
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "panel": "FullPanel.qml",
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Tend",
    "description": "See and add reminders assigned to you",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
